# Choose either the default or Docker configuration below,
# then copy your chosen configuration into a new file named `.env`(default) or `.env.docker`.

#
# Default configuration
#

DEBUG=true
SECRET_KEY='your_secret_key'
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: If these variables are not provided, SQLite3 will be used by default.
# Example configuration for using PostgreSQL:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=raviolichess_db
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT= 5432

#
# END
#

#
# Docker configuration
#

DEBUG=true
SECRET_KEY='your_secret_key'
ALLOWED_HOSTS=localhost,backend
DB_ENGINE=django.db.backends.postgresql
DB_NAME=raviolichess_db
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=db
DB_PORT= 5432

# Create another file called .env.db with theses variables
POSTGRES_USER=your_username
PGUSER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=raviolichess_db

#
# END
#