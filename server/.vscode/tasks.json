//fixme : vscode fail to run this task (happened when moving to zsh)

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Client Build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/../client"
      }
    },
    {
      "label": "Server collectstatic",
      "type": "shell",
      "command": "python3",
      "args": ["manage.py", "collectstatic", "--noinput"],
      "options": {
        "cwd": "${workspaceFolder}/src"
      }
    },
    {
      "label": "Build",
      "dependsOrder": "sequence",
      "dependsOn": ["Client Build", "Server collectstatic"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
